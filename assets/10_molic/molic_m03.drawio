<mxfile host="app.diagrams.net"><diagram id="molic-m03" name="MoLIC M03"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1230" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="628" y="23" width="44" height="44" as="geometry" /></mxCell><mxCell id="S1" value="Identificar região onde mora" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#000000;fontColor=#000000;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="460" y="170" width="380" height="130" as="geometry" /></mxCell><mxCell id="S1_body" value="informar região&lt;br&gt;d+u: região, localização&lt;br&gt;(nome, bairro ou seleção no mapa)&lt;br&gt;confirmar região consultada&lt;br&gt;d: região identificada" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="S1"><mxGeometry y="30" width="380" height="100" as="geometry" /></mxCell><mxCell id="P" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="615" y="390" width="70" height="70" as="geometry" /></mxCell><mxCell id="SR1" value="[SR] Região não identificada" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#000000;fontColor=#000000;collapsible=0;container=1;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="280" height="110" as="geometry" /></mxCell><mxCell id="SR1_body" value="d: não foi encontrada a região&lt;br&gt;indicada; sugestões de regiões válidas" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="SR1"><mxGeometry y="30" width="280" height="80" as="geometry" /></mxCell><mxCell id="SR2" value="[SR] Falha na obtenção de informações" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#000000;fontColor=#000000;collapsible=0;container=1;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="1060" y="360" width="360" height="130" as="geometry" /></mxCell><mxCell id="SR2_body" value="d: não foi possível obter os dados&lt;br&gt;neste momento&lt;br&gt;(nenhuma estimativa é exibida)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="SR2"><mxGeometry y="30" width="360" height="100" as="geometry" /></mxCell><mxCell id="SR3" value="[SR] Dados insuficientes" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#000000;fontColor=#000000;collapsible=0;container=1;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="300" height="150" as="geometry" /></mxCell><mxCell id="SR3_body" value="d: não há informações suficientes&lt;br&gt;para uma estimativa confiável&lt;br&gt;(ausência de dados não é&lt;br&gt;comunicada como risco baixo)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="SR3"><mxGeometry y="30" width="300" height="120" as="geometry" /></mxCell><mxCell id="S2" value="Interpretar o risco da região" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#000000;fontColor=#000000;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="460" y="600" width="380" height="160" as="geometry" /></mxCell><mxCell id="S2_body" value="ver risco da região&lt;br&gt;d: nível de risco, estimativa de risco&lt;br&gt;compreender o risco&lt;br&gt;d: explicação em linguagem simples,&lt;br&gt;período de referência" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="S2"><mxGeometry y="30" width="380" height="130" as="geometry" /></mxCell><mxCell id="S3" value="Consultar informações complementares" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#000000;fontColor=#000000;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="1060" y="600" width="360" height="160" as="geometry" /></mxCell><mxCell id="S3_body" value="ver condições de chuva&lt;br&gt;d: chuva, período&lt;br&gt;ver ocorrências de alagamento&lt;br&gt;d: ocorrência de alagamento, região" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="S3"><mxGeometry y="30" width="360" height="130" as="geometry" /></mxCell><mxCell id="S4" value="Avaliar necessidade de medidas preventivas" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#000000;fontColor=#000000;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="460" y="880" width="380" height="180" as="geometry" /></mxCell><mxCell id="S4_body" value="rever a situação&lt;br&gt;d: risco, período e contexto da chuva&lt;br&gt;considerar medidas preventivas&lt;br&gt;d: medidas preventivas (proteger objetos&lt;br&gt;e equipamentos, verificar pontos&lt;br&gt;vulneráveis, acompanhar a situação)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="S4"><mxGeometry y="30" width="380" height="150" as="geometry" /></mxCell><mxCell id="C1" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="625" y="1125" width="50" height="50" as="geometry" /></mxCell><mxCell id="C2" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1550" y="400" width="50" height="50" as="geometry" /></mxCell><mxCell id="C3" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="165" y="780" width="50" height="50" as="geometry" /></mxCell><mxCell id="e0" value="precond: morador deseja saber se a região onde mora&lt;br&gt;apresenta risco de alagamento na previsão de chuva intensa&lt;br&gt;u: consultar risco da minha região&lt;br&gt;gco: avaliar necessidade de medidas preventivas" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="start" target="S1"><mxGeometry relative="1" as="geometry"><mxPoint x="198" y="-0.5" as="offset" /></mxGeometry></mxCell><mxCell id="e1" value="u: consultar risco" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;fontSize=12;fontFamily=Helvetica;fontColor=#000000;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="S1" target="P"><mxGeometry relative="1" as="geometry"><mxPoint x="62" y="0" as="off