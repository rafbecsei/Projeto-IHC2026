<mxfile host="app.diagrams.net"><diagram id="molic-m04" name="MoLIC M04"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1530" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="740" y="20" width="40" height="40" as="geometry" /></mxCell><mxCell id="S1" value="Identificar linha de transporte" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#000000;fontColor=#000000;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="400" height="130" as="geometry" /></mxCell><mxCell id="S1_body" value="informar linha, ponto ou terminal&lt;br&gt;d+u: número ou nome da linha;&lt;br&gt;nome do ponto ou terminal&lt;br&gt;(sugere apenas linhas e pontos existentes)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="S1"><mxGeometry x="5" y="30" width="390" height="100" as="geometry" /></mxCell><mxCell id="P1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="735" y="330" width="50" height="50" as="geometry" /></mxCell><mxCell id="SR1" value="[SR] Linha ou ponto não encontrado" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#000000;fontColor=#000000;collapsible=0;container=1;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="80" y="300" width="320" height="110" as="geometry" /></mxCell><mxCell id="SR1_body" value="d: nenhuma linha, ponto ou terminal&lt;br&gt;corresponde à busca;&lt;br&gt;o texto buscado é mantido" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="SR1"><mxGeometry x="5" y="30" width="310" height="80" as="geometry" /></mxCell><mxCell id="S2" value="Definir meu trecho" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#000000;fontColor=#000000;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="560" y="450" width="400" height="180" as="geometry" /></mxCell><mxCell id="S2_body" value="selecionar linha e sentido&lt;br&gt;d+u: linha, sentido (pelo destino final)&lt;br&gt;informar onde embarca e desembarca&lt;br&gt;d+u: ponto de embarque, ponto de desembarque&lt;br&gt;(apenas pontos da linha escolhida)&lt;br&gt;informar quando pretende sair&lt;br&gt;d+u: horário de saída (padrão: agora)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="S2"><mxGeometry x="5" y="30" width="390" height="150" as="geometry" /></mxCell><mxCell id="P2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="735" y="690" width="50" height="50" as="geometry" /></mxCell><mxCell id="AL" value="[AL] Pontos fora do sentido escolhido" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#000000;fontColor=#000000;collapsible=0;container=1;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="1150" y="560" width="400" height="110" as="geometry" /></mxCell><mxCell id="AL_body" value="d: o desembarque não vem depois do&lt;br&gt;embarque neste sentido; deseja trocar&lt;br&gt;o sentido ou corrigir os pontos?" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="AL"><mxGeometry x="5" y="30" width="390" height="80" as="geometry" /></mxCell><mxCell id="SR2" value="[SR] Risco indisponível para a linha" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#000000;fontColor=#000000;collapsible=0;container=1;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="80" y="640" width="380" height="120" as="geometry" /></mxCell><mxCell id="SR2_body" value="d: não foi possível obter o risco&lt;br&gt;desta linha neste momento&lt;br&gt;(nenhuma estimativa é exibida;&lt;br&gt;tente mais tarde ou consulte outra linha)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="SR2"><mxGeometry x="5" y="30" width="370" height="90" as="geometry" /></mxCell><mxCell id="endSR2" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="250" y="810" width="40" height="40" as="geometry" /></mxCell><mxCell id="S3" value="Analisar risco ao longo da linha" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#000000;fontColor=#000000;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="560" y="900" width="400" height="170" as="geometry" /></mxCell><mxCell id="S3_body" value="ver itinerário da linha&lt;br&gt;d: itinerário, trechos por nível de risco&lt;br&gt;(meu trecho destacado: embarque → desembarque)&lt;br&gt;compreender o risco no meu trecho&lt;br&gt;d: nível de risco, significado do risco&lt;br&gt;d: atualização das informações" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="S3"><mxGeometry x="5" y="30" width="390" height="140" as="geometry" /></mxCell><mxCell id="S4" value="Verificar previsão até o horário de passagem" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#000000;fontColor=#000000;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="1150" y="900" width="400" height="170" as="geometry" /></mxCell><mxCell id="S4_body" value="ver previsão no meu trecho&lt;br&gt;d: horário de passagem (estimado),&lt;br&gt;previsão do risco&lt;br&gt;simular outro horário de saída&lt;br&gt;d+u: horário de saída&lt;br&gt;(horários já passados não são aceitos)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="S4"><mxGeometry x="5" y="30" width="390" height="140" as="geometry" /></mxCell><mxCell id="S5" value="Examinar trecho de risco" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#000000;fontColor=#000000;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="80" y="900" width="340" height="170" as="geometry" /></mxCell><mxCell id="S5_body" value="ver detalhes do trecho&lt;br&gt;d: estimativa de risco (%)&lt;br&gt;d: chuva (mm, período)&lt;br&gt;d: ocorrência de alagamento&lt;br&gt;(ocorrência registrada ≠ risco estimado)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="S5"><mxGeometry x="5" y="30" width="330" height="140" as="geometry" /></mxCell><mxCell id="S6" value="Decidir como realizar o deslocamento" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#000000;fontColor=#000000;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="560" y="1160" width="400" height="170" as="geometry" /></mxCell><mxCell id="S6_body" value="rever o risco no meu trecho&lt;br&gt;d: linha, sentido, nível de risco,&lt;br&gt;previsão do risco, horário de saída&lt;br&gt;escolher como ir&lt;br&gt;manter linha e horário, antecipar a saída&lt;br&gt;ou usar outra linha ou modal&lt;br&gt;(a decisão é da usuária)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="S6"><mxGeometry x="5" y="30" width="390" height="140" as="geometry" /></mxCell><mxCell id="S7" value="Comparar linhas consultadas" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=6;startSize=30;fontStyle=1;fontSize=13;fontFamily=Helvetica;fillColor=#ffffff;swimlaneFillColor=#ffffff;strokeColor=#000000;fontColor=#000000;collapsible=0;container=1;" vertex="1" parent="1"><mxGeometry x="80" y="1160" width="340" height="150" as="geometry" /></mxCell><mxCell id="S7_body" value="ver linhas consultadas&lt;br&gt;d: linhas consultadas, nível de risco&lt;br&gt;e previsão no trecho de cada linha&lt;br&gt;(precond: mais de uma linha consultada)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="S7"><mxGeometry x="5" y="30" width="330" height="120" as="geometry" /></mxCell><mxCell id="end" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#000000;strokeColor=#000000;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="740" y="1420" width="40" height="40" as="geometry" /></mxCell><mxCell id="e0" value="precond: Juliana tem prova às 19h e recebeu alerta de temporal&lt;br&gt;u: consultar o risco da linha que eu uso&lt;br&gt;gco: decidir como realizar o deslocamento" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=8;strokeColo